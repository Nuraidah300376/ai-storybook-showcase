{
  "name": "ai-storybook-showcase",
  "private": true,
  "version": "0.4.0",
  "description": "AI Storybook Showcase — persembahan buku cerita bergambar Amanah Kecil, Hati Besar karya Nuraidah binti Mustapah.",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "semak": "tsc -b --noEmit",
    "ujian": "vitest run",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "binaan:pratonton": "tsc -b && vite build --mode pratonton",
    "eksport:pelayan": "npm run build && vite preview --open /#tiktok-60",
    "eksport:video": "npm run build && node scripts/eksport-video.mjs && node scripts/semak-video.mjs eksport/tiktok-60s.mp4",
    "semak:video": "node scripts/semak-video.mjs eksport/tiktok-60s.mp4"
  },
  "dependencies": {
    "@fontsource/fraunces": "^5.2.0",
    "@fontsource/plus-jakarta-sans": "^5.2.0",
    "fflate": "^0.8.3",
    "jsqr": "^1.4.0",
    "motion": "^12.0.0",
    "qrcode": "^1.5.4",
    "react": "^19.1.0",
    "react-dom": "^19.1.0"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.1.0",
    "@types/node": "^22.20.5",
    "@types/pngjs": "^6.0.5",
    "@types/qrcode": "^1.5.6",
    "@types/react": "^19.1.0",
    "@types/react-dom": "^19.1.0",
    "@vitejs/plugin-react": "^6.1.2",
    "playwright": "1.63.0",
    "pngjs": "^7.0.0",
    "tailwindcss": "^4.1.0",
    "typescript": "~5.8.3",
    "vite": "^8.3.5",
    "vite-plugin-singlefile": "^2.3.4",
    "vitest": "^5.0.5"
  }
}
